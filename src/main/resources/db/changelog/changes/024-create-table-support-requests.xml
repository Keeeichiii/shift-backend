<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create_table_support_requests" author="ea.novak">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="support_requests"/>
            </not>
        </preConditions>

        <createTable tableName="support_requests">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="contact_channel" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="subject" type="varchar(160)">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="support_requests" indexName="idx_support_requests_user_id">
            <column name="user_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="support_requests"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

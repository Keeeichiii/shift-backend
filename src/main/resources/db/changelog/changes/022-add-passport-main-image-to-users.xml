<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="add_passport_main_image_to_users" author="ea.novak">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="users" columnName="passport_main_image"/>
            </not>
        </preConditions>

        <comment>Добавление изображения главной страницы паспорта для модерации</comment>

        <addColumn tableName="users">
            <column name="passport_main_image" type="text"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="users" columnName="passport_main_image"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

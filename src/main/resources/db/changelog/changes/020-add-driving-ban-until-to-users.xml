<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="add_driving_ban_until_to_users" author="cursor">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="users" columnName="driving_ban_until"/>
            </not>
        </preConditions>

        <comment>Добавление поля лишения прав для модерации пользователей</comment>

        <addColumn tableName="users">
            <column name="driving_ban_until" type="date"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="users" columnName="driving_ban_until"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

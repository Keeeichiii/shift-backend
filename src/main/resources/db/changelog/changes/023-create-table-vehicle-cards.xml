<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create_table_vehicle_cards" author="ea.novak">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="vehicle_cards"/>
            </not>
        </preConditions>

        <createTable tableName="vehicle_cards">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="varchar(120)">
                <constraints nullable="false"/>
            </column>
            <column name="slug" type="varchar(120)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="category" type="varchar(80)">
                <constraints nullable="false"/>
            </column>
            <column name="wrapped" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="image_path" type="varchar(300)">
                <constraints nullable="false"/>
            </column>
            <column name="price_per_minute" type="decimal(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="badge" type="varchar(30)"/>
            <column name="short_description" type="varchar(500)"/>
            <column name="detail_description" type="varchar(1200)"/>
            <column name="transmission" type="varchar(80)"/>
            <column name="fuel_type" type="varchar(80)"/>
            <column name="engine" type="varchar(120)"/>
            <column name="conditions_text" type="text"/>
            <column name="features_text" type="text"/>
            <column name="minute_packages_text" type="text"/>
            <column name="hour_packages_text" type="text"/>
            <column name="day_packages_text" type="text"/>
            <column name="published" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="vehicle_cards" indexName="idx_vehicle_cards_slug">
            <column name="slug"/>
        </createIndex>

        <createIndex tableName="vehicle_cards" indexName="idx_vehicle_cards_published">
            <column name="published"/>
        </createIndex>

        <rollback>
            <dropTable tableName="vehicle_cards"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

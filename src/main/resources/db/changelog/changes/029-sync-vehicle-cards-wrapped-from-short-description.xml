<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="sync_vehicle_cards_wrapped_from_short_description_001" author="cursor">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="vehicle_cards"/>
        </preConditions>

        <sql>
            UPDATE vehicle_cards
            SET wrapped = CASE
                WHEN lower(short_description) LIKE '%без оклейки%' THEN false
                WHEN lower(short_description) LIKE '%с оклейкой%' THEN true
                ELSE wrapped
            END
            WHERE short_description IS NOT NULL;
        </sql>
    </changeSet>

</databaseChangeLog>

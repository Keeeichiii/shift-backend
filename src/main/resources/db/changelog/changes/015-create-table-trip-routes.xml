<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create_table_trip_routes" author="ea.novak">

        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="true">
                SELECT (
                           CASE
                               WHEN NOT EXISTS (
                                   SELECT 1
                                   FROM information_schema.tables
                                   WHERE table_schema = 'public'
                                     AND table_name = 'trip_routes'
                               )
                                   THEN 'true'
                               ELSE 'false'
                               END
                           );
            </sqlCheck>
        </preConditions>
        <comment>Создание таблицы маршрутов поездок</comment>

        <createTable tableName="trip_routes">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="trip_id" type="bigint">
                <constraints nullable="false" referencedTableName="trips" referencedColumnNames="id" foreignKeyName="fk_trip_routes_trip" deleteCascade="true"/>
            </column>
            <column name="recorded_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="speed_kmh" type="smallint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="location" type="geo_point">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql dbms="postgresql"><![CDATA[
ALTER TABLE trip_routes ADD CONSTRAINT chk_trip_routes_speed_non_negative CHECK (speed_kmh >= 0);
]]></sql>
        <createIndex indexName="idx_trip_routes_trip_id" tableName="trip_routes">
            <column name="trip_id"/>
        </createIndex>
        <sql splitStatements="false"><![CDATA[
            DO $$
            BEGIN
                IF EXISTS (SELECT 1 FROM pg_extension WHERE extname = 'postgis') THEN
                    IF NOT EXISTS (SELECT 1 FROM pg_indexes WHERE indexname = 'idx_trip_routes_location') THEN
                        CREATE INDEX idx_trip_routes_location ON trip_routes USING GIST (location);
                    END IF;
                END IF;
            END $$;
        ]]></sql>

        <rollback>
            <dropTable tableName="trip_routes"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

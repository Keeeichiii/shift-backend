<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create_table_long_booking_orders" author="ea.novak">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="long_booking_orders"/>
            </not>
        </preConditions>

        <createTable tableName="long_booking_orders">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false"
                             referencedTableName="users"
                             referencedColumnNames="id"
                             foreignKeyName="fk_long_booking_orders_user"/>
            </column>
            <column name="vehicle_card_id" type="bigint">
                <constraints nullable="false"
                             referencedTableName="vehicle_cards"
                             referencedColumnNames="id"
                             foreignKeyName="fk_long_booking_orders_vehicle_card"/>
            </column>
            <column name="status" type="varchar(24)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="customer_note" type="text"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="long_booking_orders" indexName="idx_long_booking_orders_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="long_booking_orders" indexName="idx_long_booking_orders_created_at">
            <column name="created_at"/>
        </createIndex>

        <rollback>
            <dropTable tableName="long_booking_orders"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
